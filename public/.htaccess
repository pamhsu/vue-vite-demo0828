<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Preserve bearer tokens when PHP runs behind FastCGI/LiteSpeed.
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Never execute script-like files from the public upload area.
  RewriteRule ^uploads/.*\.(php|phtml|phar|cgi|pl|py|sh)$ - [F,L,NC]

  # Send API requests to the PHP front controller before the Vue fallback.
  RewriteRule ^api/index\.php$ - [L]
  RewriteRule ^api/?$ api/index.php [QSA,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/(.*)$ api/index.php?route=$1 [QSA,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
